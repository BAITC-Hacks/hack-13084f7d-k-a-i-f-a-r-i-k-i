# Скопируйте в .env и выберите доступные вашему аккаунту модели.
# Ключ не нужен для локальных проверок этапа T0.
OPENAI_API_KEY=
OPENAI_MODEL_JUDGE=gpt-5-mini
OPENAI_MODEL_EXTRACT=gpt-5-mini
OPENAI_MODEL_REPORT=gpt-5
OPENAI_EMBED_MODEL=text-embedding-3-large
# Пустое значение использует стандартный адрес OpenAI.
OPENAI_BASE_URL=
LLM_CACHE_DIR=.cache/llm
