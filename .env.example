# Скопируйте в .env и заполните. .env в git НЕ коммитить.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# дешёвая модель для массового извлечения и сильная для судейства/заключения — укажите актуальные
OPENAI_MODEL_FAST=
OPENAI_MODEL_STRONG=

# --- NVIDIA NIM (build.nvidia.com, OpenAI-совместимый API) ---
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# модель эмбеддингов и reranker — проверьте актуальные имена в каталоге build.nvidia.com
NVIDIA_EMBED_MODEL=
NVIDIA_LLM_MODEL=

# --- Режим ---
# 1 = UI показывает data/mock_report.json без вызова пайплайна (для разработки фронта и страховки на демо)
USE_MOCK=1
# порог верификатора цитат (rapidfuzz partial_ratio)
VERIFY_THRESHOLD=90
